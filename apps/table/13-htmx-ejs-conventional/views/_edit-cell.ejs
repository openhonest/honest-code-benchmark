<td class="editing" data-column="<%= col %>">
  <input
    type="text"
    name="editValue"
    value="<%= value %>"
    autofocus
    hx-post="<%= basePath %>/commit-edit?id=<%= id %>&col=<%= col %>"
    hx-trigger="keyup[key=='Enter']"
    hx-target="#table-content"
    hx-swap="outerHTML"
    hx-include="#table-content input[type=hidden]"
  />
</td>
