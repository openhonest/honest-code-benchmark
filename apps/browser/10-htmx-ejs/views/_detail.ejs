<div class="detail-panel" data-role="detail-panel" style="width: 300px; padding: 1rem; border: 1px solid #ccc; border-radius: 4px">
  <div style="display: flex; justify-content: space-between; margin-bottom: 1rem">
    <strong>Record #<%= record.id %></strong>
    <button
      data-role="detail-close"
      hx-get="<%= basePath %>/close-detail"
      hx-target="#browser-content"
      hx-swap="outerHTML"
      hx-include="#browser-content input[type=hidden]"
    >&times;</button>
  </div>
  <dl>
    <dt>Name</dt><dd><%= record.name %></dd>
    <dt>Status</dt><dd><span class="badge badge-<%= record.status %>"><%= record.status %></span></dd>
    <dt>Created</dt><dd><%= record.createdDate %></dd>
    <dt>Value</dt><dd>$<%= record.value.toLocaleString() %></dd>
  </dl>
</div>
